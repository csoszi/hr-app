    {
      "mode": "data",
      "type": "template_cloudinit_config",
      "name": "config",
      "provider": "provider[\"registry.terraform.io/hashicorp/template\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "base64_encode": true,
            "gzip": false,
            "id": "3841104066",
            "part": [
              {
                "content": "#cloud-config\r\npackage_update: true\r\npackage_upgrade: true\r\npackages:\r\n  - docker.io\r\n\r\nruncmd:\r\n  - sudo systemctl enable docker\r\n  - sudo systemctl start docker\r\n  - sleep 10\r\n  - sudo docker pull davidbp11/hr-app:latest\r\n  - sudo docker run -d -p 80:8000 --restart always --name hr-app davidbp11/hr-app:latest\r\n  - echo \"Docker container started from davidbp11/hr-app:latest\" \u003e /home/ubuntu/docker_status.txt\r\n",
                "content_type": "text/cloud-config",
                "filename": "",
                "merge_type": ""
              }
            ],
            "rendered": ""
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0
        }
      ]
    },
    {
      "mode": "data",
      "type": "template_file",
      "name": "cloudinit",
      "provider": "provider[\"registry.terraform.io/hashicorp/template\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "filename": null,
            "id": "dd0dffb34e2fb4905a59aaf53cdb9b9a382372ad21e4e3bc490da863029156e8",
            "rendered": "#cloud-config\r\npackage_update: true\r\npackage_upgrade: true\r\npackages:\r\n  - docker.io\r\n\r\nruncmd:\r\n  - sudo systemctl enable docker\r\n  - sudo systemctl start docker\r\n  - sleep 10\r\n  - sudo docker pull davidbp11/hr-app:latest\r\n  - sudo docker run -d -p 80:8000 --restart always --name hr-app davidbp11/hr-app:latest\r\n  - echo \"Docker container started from davidbp11/hr-app:latest\" \u003e /home/ubuntu/docker_status.txt\r\n",
            "template": "#cloud-config\r\npackage_update: true\r\npackage_upgrade: true\r\npackages:\r\n  - docker.io\r\n\r\nruncmd:\r\n  - sudo systemctl enable docker\r\n  - sudo systemctl start docker\r\n  - sleep 10\r\n  - sudo docker pull ${dockerhub_user}/${docker_image_name}\r\n  - sudo docker run -d -p 80:8000 --restart always --name hr-app ${dockerhub_user}/${docker_image_name}\r\n  - echo \"Docker container started from ${dockerhub_user}/${docker_image_name}\" \u003e /home/ubuntu/docker_status.txt\r\n",
            "vars": {
              "docker_image_name": "hr-app:latest",
              "dockerhub_user": "davidbp11"
            }
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0
        }
      ]
    },
